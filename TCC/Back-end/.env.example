# Copie este arquivo para ".env" e ajuste se necessário.
# No XAMPP padrão, host=localhost, user=root e password vazia.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=factorytrack_db
DB_PORT=3306

PORT=3000

# URL do front-end publicado (Vercel/Netlify/GitHub Pages), usada para
# restringir o CORS em produção. Deixe em branco enquanto testa local.
FRONTEND_URL=
