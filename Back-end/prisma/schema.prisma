// Schema do Prisma — FactoryTrack
// Mapeia exatamente as tabelas já existentes em db.sql (mysql/XAMPP).
// Depois de configurar o .env, rode:
//   npx prisma migrate dev --name init
// (ou, se o banco já existir com os dados do db.sql, use:
//   npx prisma db pull   -> para conferir se bate com este schema)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Setor {
  id          Int      @id @default(autoincrement())
  nomeSetor   String   @map("nome_setor") @db.VarChar(100)
  responsavel String   @db.VarChar(100)
  criadoEm    DateTime @default(now()) @map("criado_em")

  @@map("setores")
}

model Maquina {
  id             Int      @id @default(autoincrement())
  nomeMaquina    String   @map("nome_maquina") @db.VarChar(100)
  setorAssociado String   @map("setor_associado") @db.VarChar(100)
  numeroSerie    String?  @map("numero_serie") @db.VarChar(50)
  criadoEm       DateTime @default(now()) @map("criado_em")

  @@map("maquinas")
}

model Ocorrencia {
  id             Int       @id @default(autoincrement())
  usuarioId      Int?      @map("usuario_id")
  data           DateTime
  setor          String    @db.VarChar(100)
  maquina        String    @db.VarChar(100)
  tipo           String    @db.VarChar(100)
  operador       String    @db.VarChar(100)
  turno          String    @db.VarChar(50)
  descricao      String?   @db.Text
  status         String    @default("Pendente") @db.VarChar(20)
  resolucao      String?   @db.Text
  itensChecklist String?   @db.Text
  dataResolucao  DateTime?
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull, map: "fk_ocorrencia_usuario")

  @@map("ocorrencias")
}

model Peca {
  id        Int     @id @default(autoincrement())
  nome      String  @db.VarChar(100)
  categoria String? @db.VarChar(50)
  qtd       Int     @default(0)
  min       Int     @default(0)
  unidade   String? @db.VarChar(20)

  @@map("pecas")
}

// Campos opcionais legado permitem migrar contas antigas sem perder acesso.
model Usuario {
  id      Int      @id @default(autoincrement())
  nome    String?  @db.VarChar(100)
  usuario String?  @unique(map: "uq_usuarios_usuario") @db.VarChar(100)
  senha   String   @db.VarChar(255)
  cargo   String?  @db.VarChar(50)
  tipo    String?  @db.VarChar(50)
  ativo   Boolean  @default(true)
  ocorrencias Ocorrencia[]

  @@map("usuarios")
}

model Guindaste {
  id           Int       @id @default(autoincrement())
  modelo       String    @db.VarChar(100)
  identificacao String?  @db.VarChar(100)
  status       String    @default("Disponível") @db.VarChar(30)
  alugueis     Aluguel[]

  @@map("guindastes")
}

model Aluguel {
  id                     Int        @id @default(autoincrement())
  guindasteId            Int        @map("guindaste_id")
  cliente                String     @db.VarChar(150)
  dataLocacao            DateTime   @default(now()) @map("data_locacao")
  dataPrevistaDevolucao  DateTime   @map("data_prevista_devolucao")
  dataDevolucaoReal      DateTime?  @map("data_devolucao_real")
  status                 String     @default("Ativo") @db.VarChar(30)
  guindaste              Guindaste  @relation(fields: [guindasteId], references: [id], onDelete: Restrict)

  @@map("alugueis")
}
