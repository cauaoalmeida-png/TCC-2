# Copie este arquivo para ".env" e ajuste se necessário.
# No XAMPP padrão, host=localhost, user=root e password vazia.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=factorytrack_db
DB_PORT=3306

# Na nuvem (TiDB Cloud, Aiven...) use DB_SSL=true. No XAMPP deixe false.
DB_SSL=false

# String de conexão usada pelo Prisma (deve refletir as variáveis acima).
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:@localhost:3306/factorytrack_db"

PORT=3000

# Só é necessário se o site ficar em um domínio diferente da API.
# Na Vercel o site e a API ficam no mesmo endereço, então deixe em branco.
FRONTEND_URL=

# Configure os três valores abaixo apenas na primeira inicialização do banco.
# Se a tabela de usuários estiver vazia, o servidor criará esta conta de chefe.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# Opcional: segredo persistente para assinar sessões. Use uma string aleatória longa.
AUTH_SECRET=troque-por-uma-chave-aleatoria-longa-e-persistente
